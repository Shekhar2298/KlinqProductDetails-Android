<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KlinqProductDetails" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.Klinq.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">6dp</item>
        <item name="android:tint">@color/ink</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Widget.Klinq.IconButton.Small" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">@color/ink</item>
    </style>

    <style name="Widget.Klinq.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/ink</item>
        <item name="cornerRadius">0dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.Klinq.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="iconTint">@color/ink</item>
    </style>
</resources>